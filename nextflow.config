params {

    samplesheet = "${projectDir}/samplesheet.csv"

    outdir = "results"

    reference =
        "${projectDir}/reference/GRCh38/GRCh38_no_alt.fasta"

    bwa_prefix =
        "${projectDir}/reference/GRCh38/bwa-mem2_index/2.2.1/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"

    dbsnp =
        "${projectDir}/reference/known_sites/Homo_sapiens_assembly38.dbsnp138.vcf.gz"

    known_indels =
        "${projectDir}/reference/known_sites/Homo_sapiens_assembly38.known_indels.vcf.gz"

    mills =
        "${projectDir}/reference/known_sites/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

    interval =
        "chr20:10000000-12000000"

    truth_vcf =
        "${projectDir}/truth/HG002_chr20_10_12Mb_truth.vcf.gz"

    confident_bed =
        "${projectDir}/truth/HG002_chr20_10_12Mb_confident.bed"

    reference_sdf =
        "${projectDir}/reference/GRCh38/GRCh38_no_alt.sdf"
}


process {

    executor = 'local'

    errorStrategy = 'terminate'

    maxRetries = 1

    cpus = 2
    memory = '4 GB'

    withName: FASTQC {
        cpus = 2
        memory = '2 GB'
    }

    withName: FASTP {
        cpus = 4
        memory = '4 GB'
    }

    withName: BWA_MEM2 {
        cpus = 4
        memory = '8 GB'
    }

    withName: MARK_DUPLICATES {
        cpus = 2
        memory = '6 GB'
    }

    withName: BASE_RECALIBRATOR {
        cpus = 2
        memory = '6 GB'
    }

    withName: APPLY_BQSR {
        cpus = 2
        memory = '6 GB'
    }

    withName: HAPLOTYPE_CALLER {
        cpus = 4
        memory = '8 GB'
    }

    withName: GENOTYPE_GVCF {
        cpus = 2
        memory = '4 GB'
    }

    withName: HAPPY_BENCHMARK {
        cpus = 4
        memory = '8 GB'
    }
}


conda {
    enabled = true
}


report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}


timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}


trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}


dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/workflow_dag.html"
    overwrite = true
}
